{
  "name": "nihongo-n3-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "JLPT N5-N3 learning PWA monorepo (Cloudflare Workers + React PWA)",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.4.0"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm --filter @nihongo-n3/web --filter @nihongo-n3/api --filter @nihongo-n3/db --filter @nihongo-n3/shared --filter @nihongo-n3/content -r typecheck",
    "build": "pnpm --filter @nihongo-n3/web --filter @nihongo-n3/api -r build",
    "test": "pnpm test:ops && pnpm -F @nihongo-n3/db test && pnpm -F @nihongo-n3/web test:run && pnpm -F @nihongo-n3/api test",
    "test:ops": "node --test scripts/__tests__/*.test.mjs",
    "test:e2e": "pnpm -F @nihongo-n3/e2e test",
    "lint": "pnpm --filter @nihongo-n3/web --filter @nihongo-n3/api -r lint",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "verify:ci": "pnpm openapi:check && pnpm typecheck && pnpm test && pnpm build && pnpm -F @nihongo-n3/db verify:fresh",
    "openapi:generate": "pnpm -F @nihongo-n3/api openapi:export && pnpm -F @nihongo-n3/web openapi:generate",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- apps/web/src/types/api.d.ts apps/web/src/types/admin-api.d.ts",
    "dev:api": "pnpm -F @nihongo-n3/api dev",
    "dev:web": "pnpm -F @nihongo-n3/web dev",
    "db:seed": "pnpm -F @nihongo-n3/db seed:local",
    "db:verify": "pnpm -F @nihongo-n3/db verify",
    "r1:preview-smoke": "node scripts/r1-preview-smoke.mjs",
    "ops:logpush": "node scripts/setup-logpush.mjs",
    "ops:alerts": "node scripts/setup-alerts.mjs",
    "ops:observe": "node scripts/post-deploy-observe.mjs",
    "audio:kana": "node scripts/generate-kana-audio.mjs",
    "audio:kana:upload": "node scripts/generate-kana-audio.mjs --upload"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.112.0"
  }
}
