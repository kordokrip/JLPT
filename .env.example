# Cloudflare account control-plane token used by local ops scripts only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Bucket-scoped R2 S3 credentials used only to configure Logpush delivery.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nihongo-n3-reports
LOGPUSH_PREFIX=logs/workers
WORKER_NAME=nihongo-n3-api

# Bucket-scoped Object Read credentials for strict audio release verification.
# Keep separate from Logpush delivery credentials.
AUDIO_R2_ACCESS_KEY_ID=
AUDIO_R2_SECRET_ACCESS_KEY=
AUDIO_R2_BUCKET_NAME=nihongo-n3-audio
# Optional override; default is https://<account-id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=

# Worker runtime alert delivery. Put these values into Worker secrets before deployment.
OBSERVABILITY_API_TOKEN=
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=

# Preview Worker only. Never configure this in production.
OBSERVABILITY_CANARY_TOKEN=
OBSERVABILITY_BASE_URL=
OBSERVABILITY_RECEIVER_URL=
