{
  "name": "@nihongo-n3/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/schema.ts",
  "types": "./src/schema.ts",
  "exports": {
    ".": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/api/wrangler.toml",
    "migrate:remote": "node --import=tsx src/ops/apply-migrations.ts",
    "migrate:verify": "node --import=tsx src/ops/verify-migration-ledger.ts",
    "d1:transfer": "node --import=tsx src/ops/d1-blue-green.ts",
    "d1:backup": "node --import=tsx src/ops/d1-backup.ts",
    "d1:restore-drill": "node --import=tsx src/ops/d1-restore-drill.ts",
    "release:evidence": "node --import=tsx src/ops/create-release-evidence.ts",
    "release:backfill:topik-v2": "node --import=tsx src/ops/backfill-topik-practice-v2-release.ts",
    "release:seed:content-expansion": "node --import=tsx src/ops/seed-content-expansion-reviewed.ts",
    "release:seed:next-expansion": "node --import=tsx src/ops/seed-next-content-expansion-reviewed.ts",
    "growth:readiness": "node --import=tsx src/ops/report-growth-readiness.ts",
    "content:next:quality": "node --import=tsx src/ops/report-next-content-expansion-quality.ts",
    "content:next:reviews": "node --import=tsx src/ops/write-next-content-expansion-independent-reviews.ts",
    "d1:users:cleanup": "node --import=tsx src/ops/d1-user-cleanup.ts",
    "seed:local": "node --import=tsx src/seed/seed.ts --local",
    "seed:remote": "node --import=tsx src/seed/seed.ts --remote",
    "seed:n2:local-fixture": "node --import=tsx src/seed/seed-n2-local-fixture.ts --local",
    "seed:topik:grade1:local-fixture": "node --import=tsx src/seed/seed-topik-grade1-local-fixture.ts --local",
    "seed:diff": "node --import=tsx src/seed/seed-diff.ts",
    "seed:diff:local": "node --import=tsx src/seed/seed-diff.ts",
    "verify": "node --import=tsx src/seed/verify.ts --local",
    "verify:remote": "node --import=tsx src/seed/verify.ts --remote",
    "verify:remote:audio": "node --import=tsx src/seed/verify.ts --remote && node --import=tsx src/ops/verify-audio-r2.ts --remote",
    "verify:remote:audio:r2": "node --import=tsx src/ops/verify-audio-r2.ts --remote",
    "verify:fresh": "node --import=tsx src/ops/verify-fresh.ts",
    "verify:n2:batch1": "node --import=tsx src/ops/verify-n2-batch1.ts --local",
    "verify:n2:local-fixture": "node --import=tsx src/ops/verify-n2-local-fixture.ts --local",
    "verify:topik:grade1:local-fixture": "node --import=tsx src/ops/verify-topik-grade1-local-fixture.ts --local",
    "verify:topik:owner-batch1": "node --import=tsx src/ops/verify-topik-owner-curriculum-batch1.ts --local",
    "verify:audio:provenance": "node --import=tsx src/ops/verify-learning-audio-provenance.ts --local",
    "content:contract:verify": "node --import=tsx src/ops/verify-content-release-contract.ts",
    "content:control-plane:verify": "node --import=tsx src/ops/verify-content-release-control-plane.ts",
    "topik:verify": "node --import=tsx src/ops/verify-topik-placement.ts",
    "topik:seed": "node --import=tsx src/ops/seed-topik-placement.ts",
    "topik:seed:preview": "node --import=tsx src/ops/seed-topik-placement.ts --remote --database=nihongo-n3-topik-preview --env=topik-preview",
    "topik:preview-seed": "node --import=tsx src/ops/seed-topik-preview.ts",
    "topik:practice:seed": "node --import=tsx src/ops/seed-topik-practice.ts",
    "topik:practice:seed:preview": "node --import=tsx src/ops/seed-topik-practice.ts --remote --database=nihongo-n3-topik-preview --env=topik-preview",
    "topik:practice:verify": "node --import=tsx src/ops/verify-topik-practice.ts",
    "topik:practice:verify:remote": "node --import=tsx src/ops/verify-topik-practice.ts --remote --database=nihongo-n3-prod-v2",
    "question:quality": "node --import=tsx src/ops/audit-question-bank-quality.ts --local",
    "question:quality:remote": "node --import=tsx src/ops/audit-question-bank-quality.ts --remote --database=nihongo-n3-prod-v2",
    "topik:official:seed": "node --import=tsx src/ops/seed-topik-official-reference.ts",
    "topik:official:verify": "node --import=tsx src/ops/verify-topik-official-reference.ts",
    "topik:official:verify:remote": "node --import=tsx src/ops/verify-topik-official-reference.ts --remote",
    "test": "node --import=tsx --test src/ops/*.test.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "aws4fetch": "1.0.20",
    "dotenv": "16.6.1",
    "drizzle-kit": "^0.31.10",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "wrangler": "^4.103.0"
  }
}
