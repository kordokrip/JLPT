{
  "name": "@nihongo-n3/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/schema.ts",
  "types": "./src/schema.ts",
  "exports": {
    ".": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../../apps/api/wrangler.toml",
    "migrate:remote": "tsx src/ops/apply-migrations.ts",
    "migrate:verify": "tsx src/ops/verify-migration-ledger.ts",
    "d1:transfer": "tsx src/ops/d1-blue-green.ts",
    "d1:backup": "tsx src/ops/d1-backup.ts",
    "d1:restore-drill": "tsx src/ops/d1-restore-drill.ts",
    "seed:local": "tsx src/seed/seed.ts --local",
    "seed:remote": "tsx src/seed/seed.ts --remote",
    "seed:diff": "tsx src/seed/seed-diff.ts",
    "seed:diff:local": "tsx src/seed/seed-diff.ts",
    "verify": "tsx src/seed/verify.ts --local",
    "verify:remote": "tsx src/seed/verify.ts --remote",
    "verify:audio": "tsx src/seed/verify.ts --local --require-audio",
    "verify:remote:audio": "tsx src/seed/verify.ts --remote --require-audio && tsx src/ops/verify-audio-r2.ts --remote",
    "verify:remote:audio:r2": "tsx src/ops/verify-audio-r2.ts --remote",
    "verify:fresh": "tsx src/ops/verify-fresh.ts",
    "verify:fresh:audio": "tsx src/ops/verify-fresh.ts --require-audio",
    "test": "tsx --test src/ops/*.test.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "aws4fetch": "1.0.20",
    "dotenv": "16.6.1",
    "drizzle-kit": "^0.31.10",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "wrangler": "^4.103.0"
  }
}
