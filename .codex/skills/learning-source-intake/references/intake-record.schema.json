{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning source intake record",
  "type": "object",
  "required": ["source", "facts"],
  "properties": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "url",
        "license",
        "attribution",
        "allowed_use",
        "retrieved_at",
        "sha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "format": "uri" },
        "license": {
          "type": "object",
          "required": ["id", "url"],
          "properties": {
            "id": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "attribution": { "type": "string", "minLength": 1 },
        "allowed_use": { "const": "language-facts-and-metadata-only" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "language", "value", "source_locator"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "lexical-form",
              "reading",
              "sense-label",
              "grammar-constraint",
              "exam-structure"
            ]
          },
          "language": { "enum": ["ja", "ko", "en"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 500 },
          "source_locator": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
